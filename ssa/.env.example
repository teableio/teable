# ============================================================================
# SSA companion services — environment template
# Copy to `.env` (never commit it) and fill in real values.
# See docs/ssa/ENVIRONMENT.md for the full catalogue and how to obtain each one.
# ============================================================================

# ── Shared (backend <-> services) ───────────────────────────────────────────
# Long random string; must equal the backend's SSA_INTERNAL_TOKEN.
SSA_INTERNAL_TOKEN=change-me

# Teable origin + API token used by services for REST calls.
SSA_TEABLE_BASE_URL=http://127.0.0.1:3000
SSA_TEABLE_API_TOKEN=teable_pat_change-me

# ── ssa/services/notify (M3) ────────────────────────────────────────────────
SSA_PORT=4600
SSA_BIND=127.0.0.1
# Must equal the backend's SSA_EVENTS_WEBHOOK_SECRET.
SSA_EVENTS_WEBHOOK_SECRET=change-me
GMAIL_USER=you@yourdomain.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
GMAIL_SENDER_NAME=SSA
SSA_DIGEST_CRON=0 8 * * *
SSA_DIGEST_TZ=Asia/Kuala_Lumpur
SSA_DIGEST_RECIPIENTS=ops@yourdomain.com
SSA_DRY_RUN=false

# ── ssa/services/ai (M4) ────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Examples:
#   OpenCode gateway : https://opencode.ai/zen/v1            (preferred)
#   DeepSeek         : https://api.deepseek.com/v1
#   Local Ollama     : http://localhost:11434/v1             (key can be "ollama")
SSA_AI_BASE_URL=https://opencode.ai/zen/v1
SSA_AI_API_KEY=sk-change-me
SSA_AI_MODEL=deepseek-v4.1-flash
SSA_AI_TEMPERATURE=0.2
SSA_AI_MAX_STEPS=8

# Exposed to the web app (Next.js) for the assistant drawer:
SSA_ASSISTANT_ENABLED=true
SSA_ASSISTANT_SERVICE_URL=http://127.0.0.1:4700

# ── ssa/voice (M5) ──────────────────────────────────────────────────────────
SSA_VOICE_MODE=local
# Twilio carrier (telephony mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Speech providers (optional if using local models)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
