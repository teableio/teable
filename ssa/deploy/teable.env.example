# ============================================================================
# teable container — app config + secrets.
# Copy to `teable.env` (never commit), fill in, then start the stack.
# Every variable is catalogued in docs/ssa/ENVIRONMENT.md.
# ============================================================================

NODE_ENV=production
# Must match DOMAIN in .env (scheme + host).
PUBLIC_ORIGIN=https://ssa.example.com
# Invite-only instance: disables sign-ups and the waitlist at every boot.
SSA_SINGLE_TENANT=true

# ── Database ─────────────────────────────────────────────────────────────────
# Neon free tier (recommended): Connection string + statement_cache_size=0
# (docs/ssa/ENVIRONMENT.md §6 — the dashboard string already has sslmode=require).
PRISMA_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&statement_cache_size=0
# …or the localdb profile (paste your real POSTGRES_PASSWORD from .env):
# PRISMA_DATABASE_URL=postgresql://teable:REPLACE_ME@teable-db:5432/teable?schema=public
#
# BACKEND_CACHE_REDIS_URI is assembled by docker-compose from REDIS_PASSWORD.

# ── Attachments (persistent volume `teable-data`) ────────────────────────────
BACKEND_STORAGE_PROVIDER=local
BACKEND_STORAGE_LOCAL_PATH=/app/.assets

# ── Mail: Gmail SMTP (docs/ssa/ENVIRONMENT.md §1.1) ──────────────────────────
BACKEND_MAIL_HOST=smtp.gmail.com
BACKEND_MAIL_PORT=465
BACKEND_MAIL_SECURE=true
BACKEND_MAIL_SENDER=bot@yourdomain.com
BACKEND_MAIL_SENDER_NAME=SSA
BACKEND_MAIL_AUTH_USER=bot@yourdomain.com
BACKEND_MAIL_AUTH_PASS=xxxxxxxxxxxxxxxx # 16-char Google App Password

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate once on a new deployment and NEVER change them afterwards (changing
# a key breaks the data encrypted under it). Commands match the backend's boot
# warning (apps/nestjs-backend/src/configs/secrets/). *_ENCRYPTION_KEY/_IV slots
# are aes-128 → exactly 16 chars.
SECRET_KEY=           # openssl rand -base64 32
BACKEND_JWT_SECRET=   # openssl rand -base64 32
BACKEND_SESSION_SECRET= # openssl rand -base64 32
BACKEND_ACCESS_TOKEN_ENCRYPTION_KEY= # openssl rand -hex 8 (personal access tokens)
BACKEND_ACCESS_TOKEN_ENCRYPTION_IV=  # openssl rand -hex 8
BACKEND_MAIL_ENCRYPTION_KEY= # openssl rand -hex 8 (unsubscribe-link tokens)
BACKEND_MAIL_ENCRYPTION_IV=  # openssl rand -hex 8
BACKEND_STORAGE_ENCRYPTION_KEY= # openssl rand -hex 8 (attachment URL tokens, local storage)
BACKEND_STORAGE_ENCRYPTION_IV=  # openssl rand -hex 8
BACKEND_AI_CONFIG_ENCRYPTION_SECRET= # openssl rand -base64 32 (AI provider keys in instance settings)
# Optional: only for EE env-variable encryption / BYODB deployments.
# BACKEND_ENV_VARIABLE_SECRET=
# BACKEND_DATA_DB_URL_ENCRYPTION_KEY=
# BACKEND_DATA_DB_URL_ENCRYPTION_IV=

# ── SSA services ─────────────────────────────────────────────────────────────
# Long random string; must equal the value in ssa-notify.env / ssa-ai.env.
SSA_INTERNAL_TOKEN=change-me
SSA_EVENTS_WEBHOOK_URL=http://ssa-notify:4600/events
# Must equal ssa-notify.env's SSA_EVENTS_WEBHOOK_SECRET.
SSA_EVENTS_WEBHOOK_SECRET=change-me
SSA_ASSISTANT_ENABLED=true
SSA_ASSISTANT_SERVICE_URL=http://ssa-ai:4700
# Optional: limit which tables forward record events (comma list of tbl… ids)
# SSA_EVENTS_TABLES=
# Optional branding (see docs/ssa/BRANDING.md)
# SSA_BRAND_NAME=SSA
# SSA_BRAND_LOGO=
