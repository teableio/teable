# ============================================================================
# ssa-notify container — Gmail digest + record event alerts.
# Copy to `ssa-notify.env` (never commit). Catalogue: docs/ssa/ENVIRONMENT.md §3.
# ============================================================================

# In a container the service must bind all interfaces (host loopback would be
# unreachable from the compose network).
SSA_BIND=0.0.0.0
SSA_PORT=4600
SSA_LOG_LEVEL=info

# Shared with the backend / other services.
SSA_INTERNAL_TOKEN=change-me           # = teable.env
SSA_EVENTS_WEBHOOK_SECRET=change-me    # = teable.env

# Teable REST access (compose service name + scoped personal access token).
SSA_TEABLE_BASE_URL=http://teable:3000
SSA_TEABLE_API_TOKEN=teable_pat_change-me # Settings → Personal Access Tokens

# Gmail SMTP (same App Password scheme as the backend, docs §1.1).
GMAIL_USER=bot@yourdomain.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
GMAIL_SENDER_NAME=SSA

# Digest schedule (cron + IANA timezone) and recipients.
SSA_DIGEST_CRON=0 8 * * *
SSA_DIGEST_TZ=UTC
SSA_DIGEST_RECIPIENTS=ops@yourdomain.com

# Start in dry-run (logs instead of sending); flip to false once rules fit.
SSA_DRY_RUN=true

# Rules + digest JSON, mounted read-only from ./notify (see README).
SSA_RULES_FILE=/app/config/notify.rules.json
SSA_DIGEST_FILE=/app/config/notify.digest.json
