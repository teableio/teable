# ============================================================================
# ssa/deploy — compose-level settings (infrastructure only).
# Copy to `.env` (never commit) and edit. App config/secrets live in
# teable.env / ssa-notify.env / ssa-ai.env — see their *.example templates.
# ============================================================================

# Public hostname, no scheme. Used by Caddy and must equal PUBLIC_ORIGIN's host
# in teable.env. For DuckDNS: "yourname.duckdns.org".
DOMAIN=ssa.example.com

# ── TLS edge — pick ONE profile at `docker compose --profile <name> up` ──────
# edge-caddy (default) — Caddy terminates TLS:
#   • normal domain (Let's Encrypt HTTP-01):  CADDYFILE=Caddyfile            CADDY_DOCKERFILE=Dockerfile.plain
#   • free DuckDNS subdomain (DNS-01):        CADDYFILE=Caddyfile.duckdns    CADDY_DOCKERFILE=Dockerfile.duckdns + DUCKDNS_TOKEN
#   Inbound 80/443 must be open in the firewall for Caddy.
CADDYFILE=Caddyfile
CADDY_DOCKERFILE=Dockerfile.plain
DUCKDNS_TOKEN=

# edge-tunnel — Cloudflare Tunnel (cloudflared); no inbound ports needed.
# Needs a Cloudflare-managed domain + a tunnel token from
# Zero Trust → Networks → Tunnels. DNS is managed by Cloudflare.
TUNNEL_TOKEN=

# ── Shared ───────────────────────────────────────────────────────────────────
TIMEZONE=UTC
# Redis (cache + BullMQ queues) — only this file needs the real password.
REDIS_PASSWORD=change-me-long-random

# ── localdb profile only (Postgres inside compose instead of Neon) ──────────
# Remember to point PRISMA_DATABASE_URL at teable-db:5432 in teable.env.
POSTGRES_PASSWORD=change-me-long-random
