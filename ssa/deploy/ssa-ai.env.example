# ============================================================================
# ssa-ai container — in-app AI assistant (OpenAI-compatible, Teable tools).
# Copy to `ssa-ai.env` (never commit). Catalogue: docs/ssa/ENVIRONMENT.md §4.
# ============================================================================

SSA_BIND=0.0.0.0
SSA_PORT=4700
SSA_LOG_LEVEL=info

SSA_INTERNAL_TOKEN=change-me           # = teable.env / ssa-notify.env

# Teable REST access (scoped token: the assistant can create records but has
# no delete tool by design).
SSA_TEABLE_BASE_URL=http://teable:3000
SSA_TEABLE_API_TOKEN=teable_pat_change-me

# LLM endpoint (any OpenAI-compatible, including /v1).
SSA_AI_ENABLED=true
SSA_AI_BASE_URL=https://opencode.ai/zen/v1
SSA_AI_API_KEY=sk-change-me
SSA_AI_MODEL=deepseek-v4.1-flash
SSA_AI_TEMPERATURE=0.2
SSA_AI_MAX_STEPS=8
SSA_AI_MAX_HISTORY=20
# SSA_AI_SYSTEM_PROMPT=Extra operator instructions appended to the system prompt

# Local Ollama instead (running on the Docker host):
#   SSA_AI_BASE_URL=http://host.docker.internal:11434/v1
#   SSA_AI_API_KEY=ollama
#   SSA_AI_MODEL=qwen2.5:14b
