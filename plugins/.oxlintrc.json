{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "../packages/eslint-config-bases/src/bases/typescript.json",
    "../packages/eslint-config-bases/src/bases/sonar.json",
    "../packages/eslint-config-bases/src/bases/regexp.json",
    "../packages/eslint-config-bases/src/bases/jest.json",
    "../packages/eslint-config-bases/src/bases/react.json",
    "../packages/eslint-config-bases/src/bases/tailwind.json",
    "../packages/eslint-config-bases/src/bases/rtl.json",
    "../packages/eslint-config-bases/src/bases/nextjs.json"
  ],
  "ignorePatterns": [
    ".*",
    "build",
    "dist",
    "storybook-static",
    "next-env.d.ts",
    "*.config.js",
    "*.config.mjs",
    "scripts/*"
  ],
  "settings": {
    "import/resolver": {
      "typescript": {}
    }
  },
  "rules": {
    "teable/naming-convention": "off",
    "nextjs/no-img-element": "off"
  },
  "overrides": [
    {
      // Rules a preset sets for a file pattern can only be changed from an override.
      "files": ["**/*"],
      "rules": {
        "jsx-a11y/anchor-is-valid": "off",
        "jsx-a11y/label-has-associated-control": "off"
      }
    },
    {
      "files": ["src/_*.{ts,tsx}"],
      "rules": {
        "react/display-name": "off"
      }
    },
    {
      "files": ["**/*.{spec,test}.{ts,tsx}"],
      "rules": {
        "react/display-name": "off",
        "typescript/no-explicit-any": "off",
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-static-element-interactions": "off"
      }
    }
  ]
}
