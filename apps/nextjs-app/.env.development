#######################################################################################
# BUILD ENVIRONMENT - Consumed by next.config.mjs during build and development     #
#######################################################################################
NEXT_BUILD_ENV_CSP=false
NEXT_BUILD_ENV_SENTRY_ENABLED=false
NEXT_BUILD_ENV_SENTRY_UPLOAD_DRY_RUN=false
#######################################################################################

# ↓↓↓↓↓↓↓↓ frontend（nextjs） env ↓↓↓↓↓↓↓↓
BACKEND_STORAGE_PROVIDER=local
BACKEND_STORAGE_PUBLIC_BUCKET=public
BACKEND_STORAGE_PUBLIC_URL=http://localhost:3000/api/attachments/read/public
# ↓↓↓↓↓↓↓↓ backend（nestjs） env ↓↓↓↓↓↓↓↓
NEXTJS_DIR=../nextjs-app
LOG_LEVEL=info
PORT=3000
SOCKET_PORT=3001
PUBLIC_ORIGIN=http://localhost:3000
I18N_TYPES_OUTPUT_PATH=./src/types/i18n.generated.ts
# DATABASE_URL
# @see https://www.prisma.io/docs/reference/database-reference/connection-urls#examples
PRISMA_DATABASE_URL=postgresql://teable:teable@127.0.0.1:5432/teable?schema=public&statement_cache_size=0
# Optional split-db override:
# PRISMA_META_DATABASE_URL=postgresql://teable:teable@127.0.0.1:5432/teable-meta?schema=public&statement_cache_size=0
# PRISMA_DATA_DATABASE_URL=postgresql://teable:teable@127.0.0.1:5432/teable-data?schema=public&statement_cache_size=0
# Optional per-process limit for the default PostgreSQL endpoint (overrides URL connection_limit):
# DATABASE_POOL_MAX=8
# Optional limit for each active BYODB PostgreSQL endpoint:
# BYODB_DATA_DB_POOL_MAX=5
# BYODB data-pool budget: pods × databases × (data pool + 2 auxiliary connections) ≤ max_connections × 0.8.
# Auxiliary = domain-event maintenance 1 + domain-event probe 1 on the same customer database;
# table-query observation uses the meta connection string and is budgeted on the meta server.
# All three inputs are required; a partial topology keeps the legacy data pool of 5 rather than guessing:
# BYODB_DATA_DB_PG_MAX_CONNECTIONS=1702
# BYODB_DATA_DB_DATABASES_PER_SERVER=1
# BYODB_APP_NODES=5
# Saturation guard: queue depth defaults to the pool max; queued waiters fail after 2s instead of hanging:
# BYODB_DATA_DB_QUEUE_LIMIT=20
# BYODB_DATA_DB_QUEUE_TIMEOUT_MS=2000
# The coordination pool uses the meta connection string, not the customer database. One pool exists per
# cached BYODB container: pods × warm containers × maxConnections must fit the meta server budget.
# BYODB containers default to 32 slots and a 2s acquire timeout; lower it for small meta servers:
# V2_SCHEMA_COORDINATION_MAX_CONNECTIONS=32
# V2_SCHEMA_COORDINATION_CONNECTION_TIMEOUT_MS=2000
BACKEND_CACHE_REDIS_URI=redis://:teable@127.0.0.1:6379/0

API_DOC_DISENABLED=false
API_DOC_ENABLED_SNIPPET=false
CALC_CHUNK_SIZE=400
# Secrets are deliberately NOT set here: the backend falls back to the same
# built-in legacy defaults a zero-config self-hosted instance runs on (see
# configs/secrets/secret-specs.ts) — expect the boot security warning.
