#######################################################################################
# 1. BUILD ENVIRONMENT - Consumed by next.config.mjs during build and development     #
#######################################################################################
NEXT_BUILD_ENV_OUTPUT=classic
NEXT_BUILD_ENV_SOURCEMAPS=false
#NEXT_BUILD_ENV_TYPECHECK=false
NEXT_BUILD_ENV_CSP=true
NEXT_PUBLIC_BUILD_VERSION=develop
#######################################################################################

# ↓↓↓↓↓↓↓↓ frontend（nextjs） env ↓↓↓↓↓↓↓↓

# ↓↓↓↓↓↓↓↓ backend（nestjs） env ↓↓↓↓↓↓↓↓
# DATABASE_URL
# When deploying on serveless/lambdas "?connection_limit=" should be 1
# @see https://www.prisma.io/docs/concepts/components/prisma-client/deployment#recommended-connection-limit
# PRISMA_DATABASE_URL=

# See https://github.com/soluble-io/cache-interop
APP_CACHE_DSN=

LOG_LEVEL=info

NEXTJS_DIR=../nextjs-app
PORT=3000
SOCKET_PORT=3000

API_DOC_ENABLED_SNIPPET=true

I18NEXT_DEFAULT_CONFIG_PATH=${NEXTJS_DIR}/next-i18next.config.js

# SSA fork extensions (production template; see docs/ssa/ENVIRONMENT.md)
# Invite-only single tenant:
#SSA_SINGLE_TENANT=true
# Internal shared secret (backend + Next proxy + companion services):
#SSA_INTERNAL_TOKEN=
# Record events forwarded to the notify service:
#SSA_EVENTS_WEBHOOK_URL=http://ssa-notify:4600/events
#SSA_EVENTS_WEBHOOK_SECRET=
# AI assistant drawer (proxy to ssa/services/ai):
#SSA_ASSISTANT_ENABLED=true
#SSA_ASSISTANT_SERVICE_URL=http://ssa-ai:4700
# Operator brand shown through the app's brand seam (Teable assets stay intact):
#SSA_BRAND_NAME=SSA
#SSA_BRAND_LOGO=https://workspace.example.com/ssa-logo.svg
