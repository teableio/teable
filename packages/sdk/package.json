{
  "name": "@teable/sdk",
  "version": "1.10.0",
  "license": "MIT",
  "homepage": "https://teable.ai",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/teableio/teable",
    "directory": "packages/sdk"
  },
  "author": {
    "name": "tea artist",
    "url": "https://github.com/tea-artist"
  },
  "sideEffects": false,
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "@teable/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./ui.config": {
      "import": "./ui.config.cjs",
      "require": "./ui.config.cjs",
      "types": "./ui.config.d.ts"
    },
    "./ui.config.cjs": {
      "import": "./ui.config.cjs",
      "require": "./ui.config.cjs"
    }
  },
  "files": [
    "dist",
    "tailwind.config.cjs",
    "ui.config.cjs",
    "ui.config.d.ts"
  ],
  "scripts": {
    "build": "cross-env NODE_ENV=production tsc --build tsconfig.build.json",
    "build-react17jsx": "microbundle --tsconfig ./tsconfig.build.json --jsx jsx --jsxImportSource react --globals react/jsx-runtime=jsx --compress",
    "clean": "rimraf ./dist ./coverage ./tsconfig.tsbuildinfo ./tsconfig.build.tsbuildinfo ./node_modules/.cache",
    "dev": "microbundle watch",
    "lint": "oxlint && oxfmt --check",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "test": "run-s test-unit",
    "test-unit": "vitest run --silent",
    "test-unit-cover": "pnpm test-unit --coverage",
    "fix-all-files": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@belgattitude/http-exception": "1.5.0",
    "@codemirror/autocomplete": "6.15.0",
    "@codemirror/commands": "6.3.3",
    "@codemirror/language": "6.10.1",
    "@codemirror/state": "6.4.1",
    "@codemirror/view": "6.26.0",
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@floating-ui/dom": "1.7.6",
    "@lezer/highlight": "1.2.0",
    "@milkdown/core": "7.22.3",
    "@milkdown/ctx": "7.22.3",
    "@milkdown/plugin-clipboard": "7.22.3",
    "@milkdown/plugin-history": "7.22.3",
    "@milkdown/plugin-listener": "7.22.3",
    "@milkdown/preset-commonmark": "7.22.3",
    "@milkdown/preset-gfm": "7.22.3",
    "@milkdown/prose": "7.22.3",
    "@milkdown/react": "7.22.3",
    "@radix-ui/react-icons": "1.3.2",
    "@tanstack/react-query": "5.90.16",
    "@tanstack/react-table": "8.11.7",
    "@tanstack/react-virtual": "3.14.11",
    "@teable/common-i18n": "workspace:*",
    "@teable/core": "workspace:*",
    "@teable/formula": "workspace:*",
    "@teable/icons": "workspace:*",
    "@teable/openapi": "workspace:*",
    "@teable/ui-lib": "workspace:*",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "antlr4ts": "0.5.0-alpha.4",
    "axios": "1.20.0",
    "class-transformer": "0.5.1",
    "class-variance-authority": "0.7.0",
    "copy-to-clipboard": "3.3.3",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "dayjs": "1.11.10",
    "deepmerge": "4.3.1",
    "dequal": "2.0.3",
    "fuse.js": "7.0.0",
    "immer": "10.0.4",
    "lodash": "4.18.1",
    "lru-cache": "11.5.3",
    "lucide-react": "0.363.0",
    "penpal": "6.2.2",
    "react-day-picker": "9.5.1",
    "react-hammerjs": "1.0.1",
    "react-hotkeys-hook": "4.5.0",
    "react-markdown": "9.0.1",
    "react-textarea-autosize": "8.5.9",
    "react-use": "17.6.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.0",
    "remove-markdown": "0.6.3",
    "scroller": "0.0.3",
    "sharedb": "5.2.2",
    "sockjs-client": "1.6.1",
    "ts-key-enum": "2.0.12",
    "ts-keycode-enum": "1.0.6",
    "ts-mixer": "6.0.4",
    "turndown": "7.2.2",
    "zustand": "4.5.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@teable/eslint-config-bases": "workspace:^",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.4.2",
    "@testing-library/react": "16.3.3",
    "@types/lodash": "4.17.0",
    "@types/node": "24.13.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/react-hammerjs": "1.0.7",
    "@types/scroller": "0.1.5",
    "@types/sharedb": "5.1.0",
    "@types/sockjs-client": "1.5.4",
    "@types/turndown": "5.0.6",
    "@vitest/coverage-v8": "4.1.12",
    "cross-env": "7.0.3",
    "get-tsconfig": "4.7.3",
    "happy-dom": "21.0.4",
    "microbundle": "0.15.1",
    "npm-run-all2": "6.1.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rimraf": "5.0.5",
    "tailwindcss": "3.4.1",
    "typescript": "catalog:",
    "vitest": "4.1.12"
  }
}
