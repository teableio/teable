{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "../eslint-config-bases/src/bases/typescript.json",
    "../eslint-config-bases/src/bases/regexp.json",
    "../eslint-config-bases/src/bases/sonar.json",
    "../eslint-config-bases/src/bases/jest.json",
    "../eslint-config-bases/src/bases/rtl.json",
    "../eslint-config-bases/src/bases/storybook.json",
    "../eslint-config-bases/src/bases/react.json"
  ],
  "ignorePatterns": [
    ".*",
    "build",
    "dist",
    "storybook-static",
    "next-env.d.ts",
    "/storybook-static",
    "tailwind.shadcnui.config.js"
  ],
  "settings": {
    "import/resolver": {
      "typescript": {}
    }
  },
  "overrides": [
    {
      "files": ["src/**/*.tsx"],
      "rules": {
        "teable/naming-convention": "off"
      }
    }
  ]
}
