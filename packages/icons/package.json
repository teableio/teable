{
  "name": "@teable/icons",
  "version": "1.10.0",
  "license": "MIT",
  "homepage": "https://github.com/teableio/teable",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/teableio/teable",
    "directory": "packages/icons"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf ./dist ./build ./tsconfig.tsbuildinfo ./node_modules/.cache",
    "dev": "rm -rf dist && tsc --watch",
    "test": "echo \"Error: no test specified\"",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.cjs,.mjs,.mdx --cache --cache-location ../../.cache/eslint/icons.eslintcache",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "generate": "rm -rf src/components && node ./scripts/generate.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@svgr/core": "catalog:",
    "@svgr/plugin-jsx": "catalog:",
    "@svgr/plugin-prettier": "catalog:",
    "@svgr/plugin-svgo": "catalog:",
    "@types/fs-extra": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "axios": "catalog:",
    "chalk": "catalog:",
    "dotenv": "catalog:",
    "eslint": "catalog:",
    "figma-js": "catalog:",
    "fs-extra": "catalog:",
    "lodash": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  }
}
