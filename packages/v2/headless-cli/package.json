{
  "name": "@teable/v2-headless-cli",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "bin": {
    "teable-headless": "dist/cli.cjs"
  },
  "exports": {
    ".": {
      "@teable/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "bin"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "build:bun": "tsdown --config tsdown.bundle.config.ts && bun build --compile bin/teable-headless.cjs --outfile dist/teable-headless",
    "build:bun:pglite": "tsdown --config tsdown.bundle.pglite.config.ts && node scripts/build-bun-pglite.mjs",
    "dev": "tsdown --tsconfig tsconfig.build.json --watch",
    "clean": "rimraf ./dist ./coverage ./tsconfig.tsbuildinfo ./tsconfig.build.tsbuildinfo",
    "lint": "oxlint && oxfmt --check",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "test-unit": "vitest run --silent",
    "test-unit-cover": "pnpm test-unit --coverage",
    "fix-all-files": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@teable/v2-adapter-db-postgres-shared": "workspace:*",
    "@teable/v2-headless-http": "workspace:*",
    "@teable/v2-headless-runtime": "workspace:*",
    "@teable/v2-local-attachments": "workspace:*",
    "kysely": "0.28.17",
    "reflect-metadata": "0.2.1"
  },
  "devDependencies": {
    "@teable/v2-tsdown-config": "workspace:*",
    "@teable/eslint-config-bases": "workspace:^",
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "4.1.12",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "rimraf": "5.0.5",
    "tsdown": "0.18.1",
    "typescript": "5.4.3",
    "vitest": "4.1.12"
  }
}
