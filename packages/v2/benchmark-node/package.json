{
  "name": "@teable/v2-benchmark-node",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "@teable/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --tsconfig tsconfig.build.json --watch",
    "clean": "rimraf ./dist ./coverage ./tsconfig.tsbuildinfo ./tsconfig.build.tsbuildinfo",
    "lint": "oxlint && oxfmt --check",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "bench": "vitest bench --run",
    "bench:watch": "vitest bench",
    "fix-all-files": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "@teable/v2-adapter-db-postgres-pg": "workspace:*",
    "@teable/v2-adapter-db-postgres-postgresjs": "workspace:*",
    "@teable/v2-container-node-test": "workspace:*",
    "@teable/v2-contract-http": "workspace:*",
    "@teable/v2-contract-http-client": "workspace:*",
    "@teable/v2-contract-http-express": "workspace:*",
    "@teable/v2-contract-http-fastify": "workspace:*",
    "@teable/v2-contract-http-hono": "workspace:*",
    "@teable/v2-core": "workspace:*",
    "@teable/v2-di": "workspace:*",
    "@teable/v2-table-templates": "workspace:*",
    "express": "4.22.3",
    "fastify": "5.12.7",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@teable/v2-tsdown-config": "workspace:*",
    "@teable/eslint-config-bases": "workspace:^",
    "@types/express": "4.17.21",
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "4.1.12",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "rimraf": "5.0.5",
    "tsdown": "0.23.1",
    "typescript": "catalog:",
    "vitest": "4.1.12"
  }
}
