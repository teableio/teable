{
  "name": "@teable/v2-adapter-table-repository-postgres",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "@teable/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --tsconfig tsconfig.build.json --watch",
    "clean": "rimraf ./dist ./coverage ./tsconfig.tsbuildinfo ./tsconfig.build.tsbuildinfo",
    "lint": "oxlint && oxfmt --check",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "test-unit": "vitest run --silent --bail 1",
    "test-unit-cover": "pnpm test-unit --coverage",
    "fix-all-files": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@teable/i18n-keys": "workspace:*",
    "@teable/v2-adapter-db-postgres-shared": "workspace:*",
    "@teable/v2-core": "workspace:*",
    "@teable/v2-data-query": "workspace:*",
    "@teable/v2-di": "workspace:*",
    "@teable/v2-field-dependency-core": "workspace:*",
    "@teable/v2-formula-sql-pg": "workspace:*",
    "@teable/formula": "workspace:*",
    "@teable/v2-postgres-schema": "workspace:*",
    "dayjs": "1.11.10",
    "kysely": "0.28.17",
    "neverthrow": "8.2.0",
    "transliteration": "2.3.5",
    "ts-pattern": "5.1.1",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@teable/eslint-config-bases": "workspace:^",
    "@teable/v2-adapter-db-postgres-pg": "workspace:*",
    "@teable/v2-adapter-db-postgres-pglite": "workspace:*",
    "@teable/v2-adapter-table-query-ops-postgres": "workspace:*",
    "@teable/v2-container-node-test": "workspace:*",
    "@teable/v2-table-query-ops": "workspace:*",
    "@teable/v2-table-templates": "workspace:*",
    "@teable/v2-tsdown-config": "workspace:*",
    "@testcontainers/postgresql": "11.10.0",
    "@types/node": "24.13.2",
    "@vitest/coverage-v8": "4.1.12",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "rimraf": "5.0.5",
    "testcontainers": "11.10.0",
    "tsdown": "0.23.1",
    "typescript": "catalog:",
    "vitest": "4.1.12"
  }
}
