{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@teable/v2-benchmark-bun",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "incremental": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationDir": "dist",
    "composite": true,
    "rootDir": "../",
    "outDir": "dist",
    "paths": {
      "@teable/v2-container-bun-test": ["../container-bun-test/src"],
      "@teable/v2-contract-http-implementation": ["../contract-http-implementation/src"],
      "@teable/v2-contract-http": ["../contract-http/src"],
      "@teable/v2-adapter-postgres-ddl": ["../adapter-postgres-ddl/src"],
      "@teable/v2-adapter-postgres-state": ["../adapter-postgres-state/src"],
      "@teable/v2-core": ["../core/src"],
      "@teable/v2-adapter-db-postgres-pg": ["../adapter-db-postgres-pg/src"],
      "@teable/v2-adapter-db-postgres-postgresjs": ["../adapter-db-postgres-postgresjs/src"],
      "@teable/v2-di": ["../di/src"],
      "@teable/v2-postgres-schema": ["../postgres-schema/src"]
    },
    "types": ["node"]
  },
  "exclude": ["**/node_modules", "**/.*/", "./dist", "./coverage"],
  "include": [
    "src",
    "../container-bun-test/src",
    "../contract-http-implementation/src",
    "../contract-http/src",
    "../adapter-postgres-ddl/src",
    "../adapter-postgres-state/src",
    "../core/src",
    "../adapter-db-postgres-pg/src",
    "../adapter-db-postgres-postgresjs/src",
    "../di/src",
    "../postgres-schema/src"
  ]
}
