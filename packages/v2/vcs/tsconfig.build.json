{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "rootDir": "src"
  },
  "exclude": ["dist", "**/__tests__/**", "**/*.spec.ts", "**/*.test.ts"],
  "include": ["src"]
}
