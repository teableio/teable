        WHEN pg_input_is_valid((v.val)::text, 'timestamp') THEN ((v.val)::text)::timestamp
        ELSE NULL
      END) FROM (SELECT TO_CHAR(("t"."Date")::timestamptz AT TIME ZONE 'Asia/Shanghai', 'YYYY/MM/DD HH24:MI') AS val) AS v))
      ELSE ("t"."SingleSelect" > TO_CHAR(("t"."Date")::timestamptz AT TIME ZONE 'Asia/Shanghai', 'YYYY/MM/DD HH24:MI'))
    END)",
}
