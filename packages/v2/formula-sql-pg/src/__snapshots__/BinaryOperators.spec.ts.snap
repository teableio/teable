      "fieldName": "Date",
      "fieldType": "date",
      "formattedValue": "2024/02/03 08:00",
      "formatting": {
        "date": "YYYY/MM/DD",
        "time": "HH:mm",
        "timeZone": "Asia/Shanghai",
      },
      "rawValue": "2024-02-03 00:00:00+00",
    },
  },
  "leftType": "attachment",
  "opId": "Eq",
  "operator": "=",
  "result": "false",
  "rightType": "date",
  "sql": "(CASE
      WHEN ((SELECT (pg_input_is_valid((v.val)::text, 'timestamptz') OR pg_input_is_valid((v.val)::text, 'timestamp')) FROM (SELECT (SELECT CASE
      WHEN fe.elem IS NULL OR jsonb_typeof(fe.elem) = 'null' THEN NULL
      ELSE COALESCE(fe.elem->>'title', fe.elem->>'name', fe.elem #>> '{}')
    END
    FROM (SELECT (COALESCE(NULLIF(("t"."Attachment")::jsonb, 'null'::jsonb), '[]'::jsonb) -> 0) AS elem) AS fe) AS val) AS v) AND (SELECT (pg_input_is_valid((v.val)::text, 'timestamptz') OR pg_input_is_valid((v.val)::text, 'timestamp')) FROM (SELECT TO_CHAR(("t"."Date")::timestamptz AT TIME ZONE 'Asia/Shanghai', 'YYYY/MM/DD HH24:MI') AS val) AS v)) THEN ((SELECT (CASE
        WHEN pg_input_is_valid((v.val)::text, 'timestamptz') THEN ((v.val)::text)::timestamptz
        WHEN pg_input_is_valid((v.val)::text, 'timestamp') THEN ((v.val)::text)::timestamp
        ELSE NULL
      END) FROM (SELECT (SELECT CASE
      WHEN fe.elem IS NULL OR jsonb_typeof(fe.elem) = 'null' THEN NULL
      ELSE COALESCE(fe.elem->>'title', fe.elem->>'name', fe.elem #>> '{}')
    END
    FROM (SELECT (COALESCE(NULLIF(("t"."Attachment")::jsonb, 'null'::jsonb), '[]'::jsonb) -> 0) AS elem) AS fe) AS val) AS v) = (SELECT (CASE
        WHEN pg_input_is_valid((v.val)::text, 'timestamptz') THEN ((v.val)::text)::timestamptz
        WHEN pg_input_is_valid((v.val)::text, 'timestamp') THEN ((v.val)::text)::timestamp
        ELSE NULL
      END) FROM (SELECT TO_CHAR(("t"."Date")::timestamptz AT TIME ZONE 'Asia/Shanghai', 'YYYY/MM/DD HH24:MI') AS val) AS v))
      ELSE ((SELECT CASE
      WHEN fe.elem IS NULL OR jsonb_typeof(fe.elem) = 'null' THEN NULL
      ELSE COALESCE(fe.elem->>'title', fe.elem->>'name', fe.elem #>> '{}')
    END
    FROM (SELECT (COALESCE(NULLIF(("t"."Attachment")::jsonb, 'null'::jsonb), '[]'::jsonb) -> 0) AS elem) AS fe) = TO_CHAR(("t"."Date")::timestamptz AT TIME ZONE 'Asia/Shanghai', 'YYYY/MM/DD HH24:MI'))
