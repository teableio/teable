            THEN ((("t"."ConditionalLookupType")::jsonb #>> '{}'))::jsonb
          ELSE ("t"."ConditionalLookupType")::jsonb
        END
      WHEN pg_typeof(("t"."ConditionalLookupType")) = 'json'::regtype THEN ("t"."ConditionalLookupType")::jsonb
      ELSE to_jsonb(("t"."ConditionalLookupType"))
    END)) = 'null' THEN '[]'::jsonb
      ELSE jsonb_build_array((CASE
      WHEN pg_typeof(("t"."ConditionalLookupType")) = 'jsonb'::regtype THEN
        CASE
          WHEN jsonb_typeof(("t"."ConditionalLookupType")::jsonb) = 'string' AND (LEFT(BTRIM((("t"."ConditionalLookupType")::jsonb #>> '{}')), 1) IN ('[', '{')) AND pg_input_is_valid((("t"."ConditionalLookupType")::jsonb #>> '{}'), 'jsonb')
            THEN ((("t"."ConditionalLookupType")::jsonb #>> '{}'))::jsonb
          ELSE ("t"."ConditionalLookupType")::jsonb
        END
      WHEN pg_typeof(("t"."ConditionalLookupType")) = 'json'::regtype THEN ("t"."ConditionalLookupType")::jsonb
      ELSE to_jsonb(("t"."ConditionalLookupType"))
    END))
    END) -> 0) AS elem) AS lkp) = (SELECT CASE
          WHEN lkp.elem IS NULL OR jsonb_typeof(lkp.elem) = 'null' THEN NULL
          WHEN jsonb_typeof(lkp.elem) = 'number' THEN (lkp.elem #>> '{}')::numeric::text
          WHEN jsonb_typeof(lkp.elem) = 'boolean' THEN (lkp.elem #>> '{}')
          ELSE lkp.elem #>> '{}'
        END
        FROM (SELECT ((CASE
