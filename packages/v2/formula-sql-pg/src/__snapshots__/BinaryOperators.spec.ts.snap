exports[`binary comparison operators > 'Lte' 'singleSelect' '<=' 'date' 1`] = `
{
  "formula": "{SingleSelect} <= {Date}",
  "inputs": {
    "Date": {
      "fieldName": "Date",
      "fieldType": "date",
      "formattedValue": "2024/02/03 08:00",
      "formatting": {
        "date": "YYYY/MM/DD",
        "time": "HH:mm",
        "timeZone": "Asia/Shanghai",
      },
      "rawValue": "2024-02-03 00:00:00+00",
    },
    "SingleSelect": {
      "fieldName": "SingleSelect",
      "fieldType": "singleSelect",
      "formattedValue": "10",
      "formatting": undefined,
      "rawValue": "10",
    },
  },
  "leftType": "singleSelect",
  "opId": "Lte",
  "operator": "<=",
  "result": "true",
  "rightType": "date",
  "sql": "(CASE
      WHEN ((SELECT (pg_input_is_valid((v.val)::text, 'timestamptz') OR pg_input_is_valid((v.val)::text, 'timestamp')) FROM (SELECT "t"."SingleSelect" AS val) AS v) AND (SELECT (pg_input_is_valid((v.val)::text, 'timestamptz') OR pg_input_is_valid((v.val)::text, 'timestamp')) FROM (SELECT TO_CHAR(("t"."Date")::timestamptz AT TIME ZONE 'Asia/Shanghai', 'YYYY/MM/DD HH24:MI') AS val) AS v)) THEN ((SELECT (CASE
        WHEN pg_input_is_valid((v.val)::text, 'timestamptz') THEN ((v.val)::text)::timestamptz
        WHEN pg_input_is_valid((v.val)::text, 'timestamp') THEN ((v.val)::text)::timestamp
        ELSE NULL
      END) FROM (SELECT "t"."SingleSelect" AS val) AS v) <= (SELECT (CASE
        WHEN pg_input_is_valid((v.val)::text, 'timestamptz') THEN ((v.val)::text)::timestamptz
        WHEN pg_input_is_valid((v.val)::text, 'timestamp') THEN ((v.val)::text)::timestamp
        ELSE NULL
      END) FROM (SELECT TO_CHAR(("t"."Date")::timestamptz AT TIME ZONE 'Asia/Shanghai', 'YYYY/MM/DD HH24:MI') AS val) AS v))
      ELSE ("t"."SingleSelect" <= TO_CHAR(("t"."Date")::timestamptz AT TIME ZONE 'Asia/Shanghai', 'YYYY/MM/DD HH24:MI'))
    END)",
}
`;

