          WHEN jsonb_typeof(lkp.elem) = 'boolean' THEN (lkp.elem #>> '{}')
          ELSE lkp.elem #>> '{}'
        END
        FROM (SELECT ((CASE
      WHEN ("t"."ConditionalLookupType") IS NULL THEN '[]'::jsonb
