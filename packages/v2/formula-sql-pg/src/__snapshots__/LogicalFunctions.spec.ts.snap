        FROM (SELECT ((CASE
      WHEN ("t"."LookupType") IS NULL THEN '[]'::jsonb
      WHEN jsonb_typeof((CASE
      WHEN pg_typeof(("t"."LookupType")) = 'jsonb'::regtype THEN
        CASE
          WHEN jsonb_typeof(("t"."LookupType")::jsonb) = 'string' AND (LEFT(BTRIM((("t"."LookupType")::jsonb #>> '{}')), 1) IN ('[', '{')) AND pg_input_is_valid((("t"."LookupType")::jsonb #>> '{}'), 'jsonb')
            THEN ((("t"."LookupType")::jsonb #>> '{}'))::jsonb
          ELSE ("t"."LookupType")::jsonb
        END
      WHEN pg_typeof(("t"."LookupType")) = 'json'::regtype THEN ("t"."LookupType")::jsonb
      ELSE to_jsonb(("t"."LookupType"))
    END)) = 'array' THEN (CASE
      WHEN pg_typeof(("t"."LookupType")) = 'jsonb'::regtype THEN
        CASE
          WHEN jsonb_typeof(("t"."LookupType")::jsonb) = 'string' AND (LEFT(BTRIM((("t"."LookupType")::jsonb #>> '{}')), 1) IN ('[', '{')) AND pg_input_is_valid((("t"."LookupType")::jsonb #>> '{}'), 'jsonb')
            THEN ((("t"."LookupType")::jsonb #>> '{}'))::jsonb
          ELSE ("t"."LookupType")::jsonb
        END
      WHEN pg_typeof(("t"."LookupType")) = 'json'::regtype THEN ("t"."LookupType")::jsonb
      ELSE to_jsonb(("t"."LookupType"))
    END)
      WHEN jsonb_typeof((CASE
      WHEN pg_typeof(("t"."LookupType")) = 'jsonb'::regtype THEN
        CASE
          WHEN jsonb_typeof(("t"."LookupType")::jsonb) = 'string' AND (LEFT(BTRIM((("t"."LookupType")::jsonb #>> '{}')), 1) IN ('[', '{')) AND pg_input_is_valid((("t"."LookupType")::jsonb #>> '{}'), 'jsonb')
            THEN ((("t"."LookupType")::jsonb #>> '{}'))::jsonb
          ELSE ("t"."LookupType")::jsonb
        END
      WHEN pg_typeof(("t"."LookupType")) = 'json'::regtype THEN ("t"."LookupType")::jsonb
      ELSE to_jsonb(("t"."LookupType"))
    END)) = 'null' THEN '[]'::jsonb
      ELSE jsonb_build_array((CASE
      WHEN pg_typeof(("t"."LookupType")) = 'jsonb'::regtype THEN
        CASE
          WHEN jsonb_typeof(("t"."LookupType")::jsonb) = 'string' AND (LEFT(BTRIM((("t"."LookupType")::jsonb #>> '{}')), 1) IN ('[', '{')) AND pg_input_is_valid((("t"."LookupType")::jsonb #>> '{}'), 'jsonb')
            THEN ((("t"."LookupType")::jsonb #>> '{}'))::jsonb
          ELSE ("t"."LookupType")::jsonb
        END
      WHEN pg_typeof(("t"."LookupType")) = 'json'::regtype THEN ("t"."LookupType")::jsonb
      ELSE to_jsonb(("t"."LookupType"))
    END))
    END) -> 0) AS elem) AS lkp))) IN ('false','0','no','off','null') THEN FALSE
      ELSE TRUE
    END) THEN 'yes' ELSE 'no' END)",
}
`;

exports[`logical functions > 'If' with 'multipleSelect' 1`] = `
{
  "fieldType": "multipleSelect",
  "formula": "IF({MultipleSelect}, "yes", "no")",
  "funcId": "If",
  "inputs": {
    "MultipleSelect": {
      "fieldName": "MultipleSelect",
      "fieldType": "multipleSelect",
      "formattedValue": "10, 20",
      "formatting": undefined,
      "rawValue": "["10", "20"]",
    },
  },
  "result": "yes",
  "sql": "(CASE WHEN (CASE
      WHEN (SELECT CASE
      WHEN fe.elem IS NULL OR jsonb_typeof(fe.elem) = 'null' THEN NULL
      ELSE fe.elem #>> '{}'
    END
    FROM (SELECT (COALESCE(NULLIF(("t"."MultipleSelect")::jsonb, 'null'::jsonb), '[]'::jsonb) -> 0) AS elem) AS fe) IS NULL THEN NULL
      WHEN BTRIM((SELECT CASE
      WHEN fe.elem IS NULL OR jsonb_typeof(fe.elem) = 'null' THEN NULL
      ELSE fe.elem #>> '{}'
    END
    FROM (SELECT (COALESCE(NULLIF(("t"."MultipleSelect")::jsonb, 'null'::jsonb), '[]'::jsonb) -> 0) AS elem) AS fe)) = '' THEN FALSE
      WHEN LOWER(BTRIM((SELECT CASE
      WHEN fe.elem IS NULL OR jsonb_typeof(fe.elem) = 'null' THEN NULL
      ELSE fe.elem #>> '{}'
    END
    FROM (SELECT (COALESCE(NULLIF(("t"."MultipleSelect")::jsonb, 'null'::jsonb), '[]'::jsonb) -> 0) AS elem) AS fe))) IN ('false','0','no','off','null') THEN FALSE
      ELSE TRUE
    END) THEN 'yes' ELSE 'no' END)",
}
`;

