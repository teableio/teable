          WHEN jsonb_typeof(("t"."LookupType")::jsonb) = 'string' AND (LEFT(BTRIM((("t"."LookupType")::jsonb #>> '{}')), 1) IN ('[', '{')) AND pg_input_is_valid((("t"."LookupType")::jsonb #>> '{}'), 'jsonb')
            THEN ((("t"."LookupType")::jsonb #>> '{}'))::jsonb
          ELSE ("t"."LookupType")::jsonb
        END
      WHEN pg_typeof(("t"."LookupType")) = 'json'::regtype THEN ("t"."LookupType")::jsonb
      ELSE to_jsonb(("t"."LookupType"))
    END))
    END) -> 0) AS elem) AS lkp)) = '' THEN FALSE
      WHEN LOWER(BTRIM((SELECT CASE
          WHEN lkp.elem IS NULL OR jsonb_typeof(lkp.elem) = 'null' THEN NULL
          WHEN jsonb_typeof(lkp.elem) = 'number' THEN (lkp.elem #>> '{}')::numeric::text
          WHEN jsonb_typeof(lkp.elem) = 'boolean' THEN (lkp.elem #>> '{}')
          ELSE lkp.elem #>> '{}'
        END
        FROM (SELECT ((CASE
      WHEN ("t"."LookupType") IS NULL THEN '[]'::jsonb
      WHEN jsonb_typeof((CASE
      WHEN pg_typeof(("t"."LookupType")) = 'jsonb'::regtype THEN
        CASE
          WHEN jsonb_typeof(("t"."LookupType")::jsonb) = 'string' AND (LEFT(BTRIM((("t"."LookupType")::jsonb #>> '{}')), 1) IN ('[', '{')) AND pg_input_is_valid((("t"."LookupType")::jsonb #>> '{}'), 'jsonb')
            THEN ((("t"."LookupType")::jsonb #>> '{}'))::jsonb
          ELSE ("t"."LookupType")::jsonb
        END
      WHEN pg_typeof(("t"."LookupType")) = 'json'::regtype THEN ("t"."LookupType")::jsonb
      ELSE to_jsonb(("t"."LookupType"))
    END)) = 'array' THEN (CASE
      WHEN pg_typeof(("t"."LookupType")) = 'jsonb'::regtype THEN
        CASE
          WHEN jsonb_typeof(("t"."LookupType")::jsonb) = 'string' AND (LEFT(BTRIM((("t"."LookupType")::jsonb #>> '{}')), 1) IN ('[', '{')) AND pg_input_is_valid((("t"."LookupType")::jsonb #>> '{}'), 'jsonb')
            THEN ((("t"."LookupType")::jsonb #>> '{}'))::jsonb
          ELSE ("t"."LookupType")::jsonb
        END
      WHEN pg_typeof(("t"."LookupType")) = 'json'::regtype THEN ("t"."LookupType")::jsonb
      ELSE to_jsonb(("t"."LookupType"))
    END)
      WHEN jsonb_typeof((CASE
      WHEN pg_typeof(("t"."LookupType")) = 'jsonb'::regtype THEN
        CASE
          WHEN jsonb_typeof(("t"."LookupType")::jsonb) = 'string' AND (LEFT(BTRIM((("t"."LookupType")::jsonb #>> '{}')), 1) IN ('[', '{')) AND pg_input_is_valid((("t"."LookupType")::jsonb #>> '{}'), 'jsonb')
            THEN ((("t"."LookupType")::jsonb #>> '{}'))::jsonb
          ELSE ("t"."LookupType")::jsonb
        END
      WHEN pg_typeof(("t"."LookupType")) = 'json'::regtype THEN ("t"."LookupType")::jsonb
      ELSE to_jsonb(("t"."LookupType"))
    END)) = 'null' THEN '[]'::jsonb
      ELSE jsonb_build_array((CASE
      WHEN pg_typeof(("t"."LookupType")) = 'jsonb'::regtype THEN
        CASE
          WHEN jsonb_typeof(("t"."LookupType")::jsonb) = 'string' AND (LEFT(BTRIM((("t"."LookupType")::jsonb #>> '{}')), 1) IN ('[', '{')) AND pg_input_is_valid((("t"."LookupType")::jsonb #>> '{}'), 'jsonb')
            THEN ((("t"."LookupType")::jsonb #>> '{}'))::jsonb
          ELSE ("t"."LookupType")::jsonb
        END
      WHEN pg_typeof(("t"."LookupType")) = 'json'::regtype THEN ("t"."LookupType")::jsonb
      ELSE to_jsonb(("t"."LookupType"))
    END))
    END) -> 0) AS elem) AS lkp))) IN ('false','0','no','off','null') THEN FALSE
      ELSE TRUE
    END) OR FALSE)",
}
`;

exports[`logical functions > 'Or' with 'multipleSelect' 1`] = `
{
