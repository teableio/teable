        WHEN (LEFT(BTRIM((("t"."SingleSelect"))::text), 1) IN ('[', '{')) AND pg_input_is_valid((("t"."SingleSelect"))::text, 'jsonb') THEN ((("t"."SingleSelect"))::text)::jsonb
        ELSE to_jsonb(("t"."SingleSelect"))
      END
    ELSE to_jsonb(("t"."SingleSelect"))
  END) IS NULL THEN '[]'::jsonb
    WHEN jsonb_typeof((CASE
    WHEN ("t"."SingleSelect") IS NULL THEN '[]'::jsonb
    WHEN pg_typeof(("t"."SingleSelect")) = 'jsonb'::regtype THEN to_jsonb(("t"."SingleSelect"))
    WHEN pg_typeof(("t"."SingleSelect")) = 'json'::regtype THEN to_jsonb(("t"."SingleSelect"))
    WHEN pg_typeof(("t"."SingleSelect")) IN ('text', 'varchar', 'bpchar', 'character varying', 'unknown') THEN
      CASE
        WHEN NULLIF(BTRIM((("t"."SingleSelect"))::text), '') IS NULL THEN '[]'::jsonb
        WHEN (LEFT(BTRIM((("t"."SingleSelect"))::text), 1) IN ('[', '{')) AND pg_input_is_valid((("t"."SingleSelect"))::text, 'jsonb') THEN ((("t"."SingleSelect"))::text)::jsonb
        ELSE to_jsonb(("t"."SingleSelect"))
      END
    ELSE to_jsonb(("t"."SingleSelect"))
  END)) = 'null' THEN '[]'::jsonb
    WHEN jsonb_typeof((CASE
    WHEN ("t"."SingleSelect") IS NULL THEN '[]'::jsonb
    WHEN pg_typeof(("t"."SingleSelect")) = 'jsonb'::regtype THEN to_jsonb(("t"."SingleSelect"))
    WHEN pg_typeof(("t"."SingleSelect")) = 'json'::regtype THEN to_jsonb(("t"."SingleSelect"))
    WHEN pg_typeof(("t"."SingleSelect")) IN ('text', 'varchar', 'bpchar', 'character varying', 'unknown') THEN
      CASE
        WHEN NULLIF(BTRIM((("t"."SingleSelect"))::text), '') IS NULL THEN '[]'::jsonb
        WHEN (LEFT(BTRIM((("t"."SingleSelect"))::text), 1) IN ('[', '{')) AND pg_input_is_valid((("t"."SingleSelect"))::text, 'jsonb') THEN ((("t"."SingleSelect"))::text)::jsonb
        ELSE to_jsonb(("t"."SingleSelect"))
      END
    ELSE to_jsonb(("t"."SingleSelect"))
  END)) = 'array' THEN (CASE
    WHEN ("t"."SingleSelect") IS NULL THEN '[]'::jsonb
    WHEN pg_typeof(("t"."SingleSelect")) = 'jsonb'::regtype THEN to_jsonb(("t"."SingleSelect"))
    WHEN pg_typeof(("t"."SingleSelect")) = 'json'::regtype THEN to_jsonb(("t"."SingleSelect"))
    WHEN pg_typeof(("t"."SingleSelect")) IN ('text', 'varchar', 'bpchar', 'character varying', 'unknown') THEN
      CASE
        WHEN NULLIF(BTRIM((("t"."SingleSelect"))::text), '') IS NULL THEN '[]'::jsonb
        WHEN (LEFT(BTRIM((("t"."SingleSelect"))::text), 1) IN ('[', '{')) AND pg_input_is_valid((("t"."SingleSelect"))::text, 'jsonb') THEN ((("t"."SingleSelect"))::text)::jsonb
        ELSE to_jsonb(("t"."SingleSelect"))
      END
    ELSE to_jsonb(("t"."SingleSelect"))
  END)
    ELSE jsonb_build_array((CASE
    WHEN ("t"."SingleSelect") IS NULL THEN '[]'::jsonb
    WHEN pg_typeof(("t"."SingleSelect")) = 'jsonb'::regtype THEN to_jsonb(("t"."SingleSelect"))
    WHEN pg_typeof(("t"."SingleSelect")) = 'json'::regtype THEN to_jsonb(("t"."SingleSelect"))
    WHEN pg_typeof(("t"."SingleSelect")) IN ('text', 'varchar', 'bpchar', 'character varying', 'unknown') THEN
      CASE
        WHEN NULLIF(BTRIM((("t"."SingleSelect"))::text), '') IS NULL THEN '[]'::jsonb
        WHEN (LEFT(BTRIM((("t"."SingleSelect"))::text), 1) IN ('[', '{')) AND pg_input_is_valid((("t"."SingleSelect"))::text, 'jsonb') THEN ((("t"."SingleSelect"))::text)::jsonb
        ELSE to_jsonb(("t"."SingleSelect"))
      END
    ELSE to_jsonb(("t"."SingleSelect"))
  END))
  END)) WITH ORDINALITY AS elem(value, ord)) AS combined(value, arg_index, ord)
        ORDER BY value, arg_index, ord
      ) AS uniq
    )",
}
`;

exports[`array functions > 'ArrayUnique' with 'user' 1`] = `
{
  "fieldType": "user",
  "formula": "ARRAYUNIQUE({User}, {User})",
  "funcId": "ArrayUnique",
  "inputs": {
    "User": {
      "fieldName": "User",
      "fieldType": "user",
      "formattedValue": "10, 20",
      "formatting": undefined,
      "rawValue": "[{"id": "usr_1", "title": "10"}, {"id": "usr_2", "title": "20"}]",
    },
  },
  "result": "["{\\"id\\": \\"usr_1\\", \\"title\\": \\"10\\"}", "{\\"id\\": \\"usr_2\\", \\"title\\": \\"20\\"}"]",
  "sql": "(
      SELECT jsonb_agg(value)
      FROM (
        SELECT DISTINCT ON (value) value
        FROM (SELECT elem.value, 0 AS arg_index, ord
          FROM jsonb_array_elements_text(COALESCE(NULLIF(("t"."User")::jsonb, 'null'::jsonb), '[]'::jsonb)) WITH ORDINALITY AS elem(value, ord) UNION ALL SELECT elem.value, 1 AS arg_index, ord
          FROM jsonb_array_elements_text(COALESCE(NULLIF(("t"."User")::jsonb, 'null'::jsonb), '[]'::jsonb)) WITH ORDINALITY AS elem(value, ord)) AS combined(value, arg_index, ord)
        ORDER BY value, arg_index, ord
      ) AS uniq
    )",
}
`;

