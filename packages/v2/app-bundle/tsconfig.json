{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@teable/v2-app-bundle",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "incremental": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationDir": "dist",
    "composite": false,
    "outDir": "dist",
    "paths": {
      "@teable/core": ["../../core/src"],
      "@teable/v2-adapter-db-postgres-shared": ["../adapter-db-postgres-shared/src"],
      "@teable/v2-container-browser": ["../container-browser/dist/index.d.ts"],
      "@teable/v2-core": ["../core/src"],
      "@teable/v2-di": ["../di/src"],
      "@teable/v2-dottea": ["../dottea/src"],
      "@teable/v2-headless-runtime": ["../headless-runtime/src"]
    },
    "types": ["vitest/globals", "node"]
  },
  "exclude": ["**/node_modules", "**/.*/", "./dist", "./coverage"],
  "include": ["src"]
}
