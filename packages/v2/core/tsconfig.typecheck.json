{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationDir": null,
    "isolatedModules": false,
    "noEmit": true
  },
  "exclude": [
    "**/node_modules",
    "**/.*/",
    "./dist",
    "./coverage",
    "../**/*.spec.ts",
    "../**/*.test.ts",
    "../**/testkit/**",
    "../**/__tests__/**",
    "../../**/*.spec.ts",
    "../../**/*.test.ts"
  ]
}
