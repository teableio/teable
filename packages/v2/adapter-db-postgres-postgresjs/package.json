{
  "name": "@teable/v2-adapter-db-postgres-postgresjs",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "@teable/source": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "module": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --tsconfig tsconfig.build.json --watch",
    "clean": "rimraf ./dist ./coverage ./tsconfig.tsbuildinfo ./tsconfig.build.tsbuildinfo",
    "lint": "oxlint && oxfmt --check",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "fix-all-files": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@teable/v2-adapter-db-postgres-shared": "workspace:*",
    "@teable/v2-di": "workspace:*",
    "kysely": "0.28.17",
    "kysely-postgres-js": "3.0.0",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@teable/v2-tsdown-config": "workspace:*",
    "@teable/eslint-config-bases": "workspace:^",
    "@types/node": "24.13.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "rimraf": "5.0.5",
    "tsdown": "0.23.1",
    "typescript": "catalog:"
  }
}
