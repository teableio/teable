generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model ComputedUpdateOutbox {
  id                      String                     @id @default(cuid())
  baseId                  String                     @map("base_id")
  seedTableId             String                     @map("seed_table_id")
  seedRecordIds           Json?                      @map("seed_record_ids")
  changeType              String                     @map("change_type")
  steps                   Json?
  edges                   Json?
  status                  String
  attempts                Int                        @default(0)
  maxAttempts             Int                        @default(8) @map("max_attempts")
  nextRunAt               DateTime                   @default(now()) @map("next_run_at")
  lockedAt                DateTime?                  @map("locked_at")
  lockedBy                String?                    @map("locked_by")
  lastError               String?                    @map("last_error")
  estimatedComplexity     Int                        @default(0) @map("estimated_complexity")
  planHash                String                     @map("plan_hash")
  dirtyStats              Json?                      @map("dirty_stats")
  runId                   String                     @map("run_id")
  originRunIds            String[]                   @default([]) @map("origin_run_ids")
  runTotalSteps           Int                        @default(0) @map("run_total_steps")
  runCompletedStepsBefore Int                        @default(0) @map("run_completed_steps_before")
  affectedTableIds        String[]                   @default([]) @map("affected_table_ids")
  affectedFieldIds        String[]                   @default([]) @map("affected_field_ids")
  syncMaxLevel            Int?                       @map("sync_max_level")
  sourceChangedAt         DateTime?                  @map("source_changed_at")
  stageDepth              Int                        @default(0) @map("stage_depth")
  predecessorTaskId       String?                    @map("predecessor_task_id")
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")

  seeds ComputedUpdateOutboxSeed[]

  @@index([status, nextRunAt])
  @@index([baseId, seedTableId])
  @@index([planHash])
  @@index([runId])
  @@map("computed_update_outbox")
}

model ComputedUpdateOutboxSeed {
  id       String               @id @default(cuid())
  taskId   String               @map("task_id")
  tableId  String               @map("table_id")
  recordId String               @map("record_id")
  task     ComputedUpdateOutbox @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, tableId, recordId])
  @@index([taskId])
  @@map("computed_update_outbox_seed")
}

/// Durable per-stage state for budget-staged computed updates, keyed by the
/// continuation chain's root task id (its scope). Rows are written once per
/// record and never copied between continuation tasks:
/// - kind 'excluded': processed-target exclusion ledger for partial batches;
/// - kind 'frontier': seq-ordered queue of sources whose outgoing propagation
///   is not finished (self-referential generations + migrated explicit seeds);
/// - kind 'consumed': retired frontier sources preserved for deferred edge
///   chunks, handed to the continuation as seeds at stage completion.
/// Cleared when the chain's stage completes or the chain dead-letters.
model ComputedUpdateStageLedger {
  scopeId  String @map("scope_id")
  kind     String
  tableId  String @map("table_id")
  recordId String @map("record_id")
  seq      BigInt @default(0)

  @@id([scopeId, kind, tableId, recordId])
  @@index([scopeId, kind, seq])
  @@map("computed_update_stage_ledger")
}

model ComputedUpdateDeadLetter {
  id                      String   @id
  baseId                  String   @map("base_id")
  seedTableId             String   @map("seed_table_id")
  seedRecordIds           Json?    @map("seed_record_ids")
  changeType              String   @map("change_type")
  steps                   Json?
  edges                   Json?
  status                  String
  attempts                Int      @default(0)
  maxAttempts             Int      @default(8) @map("max_attempts")
  nextRunAt               DateTime @map("next_run_at")
  lockedAt                DateTime? @map("locked_at")
  lockedBy                String?  @map("locked_by")
  lastError               String?  @map("last_error")
  estimatedComplexity     Int      @default(0) @map("estimated_complexity")
  planHash                String   @map("plan_hash")
  dirtyStats              Json?    @map("dirty_stats")
  runId                   String   @map("run_id")
  originRunIds            String[] @default([]) @map("origin_run_ids")
  runTotalSteps           Int      @default(0) @map("run_total_steps")
  runCompletedStepsBefore Int      @default(0) @map("run_completed_steps_before")
  affectedTableIds        String[] @default([]) @map("affected_table_ids")
  affectedFieldIds        String[] @default([]) @map("affected_field_ids")
  syncMaxLevel            Int?     @map("sync_max_level")
  sourceChangedAt         DateTime? @map("source_changed_at")
  stageDepth              Int      @default(0) @map("stage_depth")
  predecessorTaskId       String?  @map("predecessor_task_id")
  traceData               Json?    @map("trace_data")
  failedAt                DateTime @map("failed_at")
  createdAt               DateTime @map("created_at")
  updatedAt               DateTime @map("updated_at")

  @@index([baseId, seedTableId])
  @@index([planHash])
  @@index([runId])
  @@map("computed_update_dead_letter")
}

/// Completion ledger for computed-update outbox tasks (lineage / latency
/// tracing). Successful tasks are hard-deleted from the outbox on markDone,
/// so this table keeps a retention-bounded trail per completed task: the
/// run/stage chain (runId, stageDepth, predecessorTaskId) and the timeline
/// from source mutation to converged write (sourceChangedAt → completedAt).
/// Observability only — the worker never reads it; rows are pruned after a
/// retention window.
model ComputedUpdateRunHistory {
  taskId                  String   @id @map("task_id")
  baseId                  String   @map("base_id")
  seedTableId             String   @map("seed_table_id")
  changeType              String   @map("change_type")
  runId                   String   @map("run_id")
  originRunIds            String[] @default([]) @map("origin_run_ids")
  steps                   Json?
  edges                   Json?
  affectedTableIds        String[] @default([]) @map("affected_table_ids")
  affectedFieldIds        String[] @default([]) @map("affected_field_ids")
  /// Source (changed) field ids; populated for seed tasks, where
  /// affected_field_ids carries the trigger fields rather than targets.
  sourceFieldIds          String[] @default([]) @map("source_field_ids")
  seedRecordCount         Int      @default(0) @map("seed_record_count")
  stageDepth              Int      @default(0) @map("stage_depth")
  predecessorTaskId       String?  @map("predecessor_task_id")
  runTotalSteps           Int      @default(0) @map("run_total_steps")
  runCompletedStepsBefore Int      @default(0) @map("run_completed_steps_before")
  syncMaxLevel            Int?     @map("sync_max_level")
  estimatedComplexity     Int      @default(0) @map("estimated_complexity")
  attempts                Int      @default(0)
  outcome                 String
  sourceChangedAt         DateTime? @map("source_changed_at")
  enqueuedAt              DateTime @map("enqueued_at")
  startedAt               DateTime? @map("started_at")
  completedAt             DateTime @map("completed_at")
  durationMs              Int      @default(0) @map("duration_ms")

  @@index([runId])
  @@index([baseId, completedAt])
  @@index([completedAt])
  @@index([originRunIds], type: Gin, map: "computed_update_run_history_origin_run_ids_gin")
  @@map("computed_update_run_history")
}

model ComputedUpdatePauseScope {
  id        String    @id
  scopeType String    @map("scope_type")
  scopeId   String    @map("scope_id")
  pausedAt  DateTime  @default(now()) @map("paused_at")
  pausedBy  String?   @map("paused_by")
  resumeAt  DateTime? @map("resume_at")
  reason    String?
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  @@unique([scopeType, scopeId])
  @@index([resumeAt])
  @@map("computed_update_pause_scope")
}

/// Projection of async computed activity per field (co-located with outbox on data plane).
model ComputedFieldActivity {
  fieldId               String    @id @map("field_id")
  tableId               String    @map("table_id")
  baseId                String    @map("base_id")
  status                String
  activeTaskCount       Int       @default(0) @map("active_task_count")
  processingTaskCount   Int       @default(0) @map("processing_task_count")
  generation            BigInt    @default(0)
  estimatedComplexity   BigInt    @default(0) @map("estimated_complexity")
  estimatedDirtyRecords BigInt    @default(0) @map("estimated_dirty_records")
  hasAllTargetRecords   Boolean   @default(false) @map("has_all_target_records")
  queuedAt              DateTime? @map("queued_at")
  startedAt             DateTime? @map("started_at")
  lastCompletedAt       DateTime? @map("last_completed_at")
  lastDurationMs        Int?      @map("last_duration_ms")
  lastError             Json?     @map("last_error")
  extensions            Json?
  updatedAt             DateTime  @default(now()) @map("updated_at")

  @@index([tableId, status])
  @@index([baseId, status])
  @@map("computed_field_activity")
}

/// Projection of async computed activity per table.
model ComputedTableActivity {
  tableId               String   @id @map("table_id")
  baseId                String   @map("base_id")
  status                String
  calculatingFieldCount Int      @default(0) @map("calculating_field_count")
  queuedFieldCount      Int      @default(0) @map("queued_field_count")
  estimatedComplexity   BigInt   @default(0) @map("estimated_complexity")
  recentCompletions     Json     @default("[]") @map("recent_completions")
  generation            BigInt   @default(0)
  updatedAt             DateTime @default(now()) @map("updated_at")

  @@index([baseId, status])
  @@map("computed_table_activity")
}

/// Task→field refset for activity refcounting (prevents merge double-count).
model ComputedTaskFieldRef {
  taskId        String   @map("task_id")
  fieldId       String   @map("field_id")
  tableId       String   @map("table_id")
  baseId        String   @map("base_id")
  wasProcessing Boolean  @default(false) @map("was_processing")
  createdAt     DateTime @default(now()) @map("created_at")

  @@id([taskId, fieldId])
  @@index([fieldId])
  @@map("computed_task_field_ref")
}

model RecordHistory {
  id          String   @id @default(cuid())
  tableId     String   @map("table_id")
  recordId    String   @map("record_id")
  fieldId     String   @map("field_id")
  before      String   @map("before")
  after       String   @map("after")
  createdTime DateTime @default(now()) @map("created_time")
  createdBy   String   @map("created_by")

  @@index([tableId, recordId, createdTime])
  @@index([tableId, createdTime])
  @@map("record_history")
}

model TableTrash {
  id           String   @id @default(cuid())
  tableId      String   @map("table_id")
  resourceType String   @map("resource_type")
  snapshot     String   @map("snapshot")
  createdTime  DateTime @default(now()) @map("created_time")
  createdBy    String   @map("created_by")

  @@index([tableId])
  @@map("table_trash")
}

model RecordTrash {
  id                     String    @id @default(cuid())
  tableId                String    @map("table_id")
  recordId               String    @map("record_id")
  snapshot               String    @map("snapshot")
  createdTime            DateTime  @default(now()) @map("created_time")
  createdBy              String    @map("created_by")
  reason                 String    @default("deleted") @map("reason")
  recordCreatedTime      DateTime? @map("record_created_time")
  recordCreatedBy        String?   @map("record_created_by")
  recordLastModifiedTime DateTime? @map("record_last_modified_time")
  recordLastModifiedBy   String?   @map("record_last_modified_by")
  operationId            String?   @map("operation_id")

  @@index([tableId, recordId])
  @@map("record_trash")
}

model RecordRemovalTombstone {
  id          String   @id
  tableId     String   @map("table_id")
  recordId    String   @map("record_id")
  type        String
  createdTime DateTime @default(now()) @map("created_time")

  @@index([tableId, recordId])
  @@map("record_removal_tombstone")
}

model Attachments {
  id             String    @id @default(cuid())
  token          String    @unique
  hash           String
  size           BigInt
  mimetype       String
  path           String
  width          Int?
  height         Int?
  deletedTime    DateTime? @map("deleted_time")
  createdTime    DateTime  @default(now()) @map("created_time")
  createdBy      String    @map("created_by")
  lastModifiedBy String?   @map("last_modified_by")
  thumbnailPath  String?   @map("thumbnail_path")

  @@map("attachments")
}

model AttachmentsTable {
  id               String    @id @default(cuid())
  attachmentId     String    @map("attachment_id")
  name             String
  token            String
  tableId          String    @map("table_id")
  recordId         String    @map("record_id")
  fieldId          String    @map("field_id")
  createdTime      DateTime  @default(now()) @map("created_time")
  createdBy        String    @map("created_by")
  lastModifiedBy   String?   @map("last_modified_by")
  lastModifiedTime DateTime? @updatedAt @map("last_modified_time")

  @@index([tableId, recordId])
  @@index([tableId, fieldId])
  @@index([attachmentId])
  @@index([token])
  @@map("attachments_table")
}
