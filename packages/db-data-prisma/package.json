{
  "name": "@teable/db-data-prisma",
  "version": "1.10.0",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@teable/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma",
    "src"
  ],
  "scripts": {
    "build": "pnpm prisma-generate-ci && tsc && rm -rf ./dist/generated && mkdir -p ./dist/generated && cp -R ./src/generated/client ./dist/generated/client",
    "clean": "rimraf ./dist ./coverage ./tsconfig.tsbuildinfo ./node_modules/.cache ./src/generated",
    "dev": "tsc --watch",
    "fix-all-files": "oxlint --fix && oxfmt",
    "lint": "oxlint && oxfmt --check",
    "postinstall": "pnpm prisma-generate-ci",
    "prisma-generate": "node ./scripts/run-prisma-command.mjs generate --schema ./prisma/schema.prisma",
    "prisma-generate-ci": "node ../../scripts/prisma-generate-ci.mjs ./prisma/schema.prisma",
    "prisma-migrate": "dotenv-flow -p ../../apps/nextjs-app -- node ./scripts/run-prisma-command.mjs migrate",
    "prisma-migrate-reset": "dotenv-flow -p ../../apps/nextjs-app -- node ./scripts/run-prisma-command.mjs migrate reset --schema ./prisma/schema.prisma",
    "prisma-migrate-status": "dotenv-flow -p ../../apps/nextjs-app -- node ./scripts/run-prisma-command.mjs migrate status --schema ./prisma/schema.prisma",
    "prisma-db-push": "dotenv-flow -p ../../apps/nextjs-app -- node ./scripts/run-prisma-command.mjs db push --schema ./prisma/schema.prisma",
    "prisma-studio": "dotenv-flow -p ../../apps/nextjs-app -- node ./scripts/run-prisma-command.mjs studio --schema ./prisma/schema.prisma",
    "test": "run-s test-unit",
    "test-unit": "echo \"No unit tests yet\"",
    "test-e2e": "echo \"No e2e tests yet\"",
    "typecheck": "tsc --project ./tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "nestjs-cls": "^6.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.2.1",
    "@prisma/client": "6.2.1",
    "@teable/db-main-prisma": "workspace:^",
    "nanoid": "6.0.2",
    "pg": "8.11.5",
    "prisma": "6.2.1"
  },
  "devDependencies": {
    "@teable/eslint-config-bases": "workspace:^",
    "@types/node": "24.13.2",
    "@types/pg": "8.15.5",
    "cross-env": "7.0.3",
    "dotenv-flow-cli": "1.1.1",
    "npm-run-all2": "6.1.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "rimraf": "5.0.5",
    "rxjs": "7.8.1",
    "typescript": "catalog:"
  }
}
